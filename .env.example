# Elasticsearch (never commit real values — copy to .env)
ES_URL=https://YOUR_DEPLOYMENT.es.us-east-2.aws.elastic-cloud.com
ES_API_KEY=

# Kibana (for bootstrap / saved object scripts)
KIBANA_URL=https://YOUR_DEPLOYMENT.kb.us-east-2.aws.elastic-cloud.com

# Collector
POLL_INTERVAL_SECONDS=30
COLLECTOR_ENABLED_FEEDS=subway_1234567S
LOG_LEVEL=INFO

# Optional Bus Time (stretch)
# BUSTIME_KEY=
